# Used by docker-compose.yml. Copy to .env and adjust.
# (For `npm run dev` without Docker, use backend/.env.example instead.)

# Long random string used to sign JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Login for the database web UI (http://localhost:8081)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# Password of the demo accounts created by the seed service
SEED_PASSWORD=Password123!

# Host ports — change one if it is already used on your machine
FRONTEND_PORT=8080
API_PORT=3000
MONGO_EXPRESS_PORT=8081
MONGO_PORT=27017
