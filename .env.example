# Copy this file to .env and adjust the values.

NODE_ENV=development
PORT=3000

# MongoDB connection string (local install, Docker or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/m3alem

# Long random string used to sign JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Comma-separated list of origins allowed to call the API from another domain.
# Leave empty when the frontend is served by this same server.
CORS_ORIGIN=

# Password given to the demo accounts created by `npm run seed`.
SEED_PASSWORD=Password123!
