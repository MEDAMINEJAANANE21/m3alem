# Copy this file to backend/.env and adjust the values.

NODE_ENV=development
PORT=3000

# MongoDB connection string (local install, Docker or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/m3alem

# Long random string used to sign JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Number of reverse proxies in front of the API (1 behind nginx, 0 when called directly).
TRUST_PROXY=0

# Only needed if the frontend is hosted on another domain WITHOUT the proxy.
# Comma-separated list of allowed origins, e.g. https://m3alem.example.com
CORS_ORIGIN=

# Password given to the demo accounts created by `npm run seed`.
SEED_PASSWORD=Password123!
