{
  "name": "m3alem",
  "version": "1.0.0",
  "private": true,
  "description": "M3alem.ma — open-source marketplace for booking home-service professionals (plumbers, electricians, cleaners…).",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "seed": "npm run seed -w backend",
    "test": "npm test -w backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "marketplace",
    "home-services",
    "express",
    "mongodb",
    "vite",
    "morocco"
  ],
  "author": "JAANANE",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  }
}
