{
  "name": "m3alem",
  "version": "1.0.0",
  "description": "M3alem.ma — open-source marketplace for booking home-service professionals (plumbers, electricians, cleaners…).",
  "type": "module",
  "main": "server/src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/src/server.js",
    "dev": "node --watch --env-file-if-exists=.env server/src/server.js",
    "seed": "node --env-file-if-exists=.env server/scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"server/tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "marketplace",
    "home-services",
    "express",
    "mongodb",
    "morocco"
  ],
  "author": "JAANANE",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0"
  }
}
